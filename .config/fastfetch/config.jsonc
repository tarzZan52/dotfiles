{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "color": {
      "1": "blue",
      "2": "magenta"
    },
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "magenta"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name}@{host-name}",
      "key": " "
    },
    {
      "type": "separator",
      "string": "─────────────────────────────"
    },
    {
      "type": "os",
      "key": "  ",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "  ",
      "keyColor": "blue"
    },
    {
      "type": "packages",
      "key": " 󰏖 ",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "  ",
      "keyColor": "green"
    },
    {
      "type": "terminal",
      "key": "  ",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": " 󰖲 ",
      "keyColor": "cyan"
    },
    {
      "type": "theme",
      "key": " 󰉼 ",
      "keyColor": "magenta"
    },
    {
      "type": "icons",
      "key": " 󰀻 ",
      "keyColor": "magenta"
    },
    {
      "type": "font",
      "key": "  ",
      "keyColor": "yellow"
    },
    {
      "type": "cursor",
      "key": " 󰇀 ",
      "keyColor": "yellow"
    },
    {
      "type": "display",
      "key": " 󰍹 ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "cpu",
      "key": " 󰻠 ",
      "keyColor": "blue"
    },
    {
      "type": "memory",
      "key": " 󰍛 ",
      "keyColor": "green"
    },
    {
      "type": "disk",
      "key": " 󰋊 ",
      "keyColor": "cyan",
      "folders": "/"
    },
    {
      "type": "uptime",
      "key": " 󰅐 ",
      "keyColor": "magenta"
    },
    {
      "type": "datetime",
      "key": "  ",
      "keyColor": "yellow",
      "format": {
        "type": "strftime",
        "str": "%A, %d %B %Y  %H:%M"
      }
    },
    {
      "type": "media",
      "key": " 󰎈 ",
      "keyColor": "red"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
      "paddingLeft": 4
    }
  ]
}
